@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - Reports</title>

    <link href="~/Content/Admin/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/Content/Admin/css/admin.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/Content/Admin/img/computer.png" />
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="fas fa-cogs me-2"></i>AdminPanel
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link" href="~/Customer/Index"><i class="fas fa-users me-1"></i>Customer</a></li>
                    <li class="nav-item"><a class="nav-link" href="~/Loan/Index"><i class="fas fa-hand-holding-usd me-1"></i>Loan</a></li>
                    <li class="nav-item"><a class="nav-link" href="~/DailyEntry/Index"><i class="fas fa-calendar-day me-1"></i>Daily Entry</a></li>
                    <li class="nav-item"><a class="nav-link active" href="~/Reports/Index"><i class="fas fa-chart-bar me-1"></i>Reports</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link logout-btn" href="~/Login/Index"><i class="fas fa-sign-out-alt me-1"></i>Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4">

        <!-- PAGE HEADER -->
        <div class="page-header mb-3">
            <h2><i class="fas fa-chart-line me-2"></i>Reports</h2>
            <p class="text-muted">View, filter, and download reports by customer and date range.</p>
        </div>

        <!-- FILTER SECTION CARD -->
        <div class="card mt-4 mb-4 shadow-sm">
            <div class="card-header">
                <i class="fas fa-filter me-2"></i>Filter Reports
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <!-- Customer Filter Dropdown -->
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="customerName" class="form-label fw-semibold text-dark">
                                <i class="fas fa-user text-warning me-1"></i> Customer Name
                            </label>
                            <div class="input-group">
                                <select id="customerName" class="form-select shadow-sm border px-3">
                                    <option value="">-- All Customers --</option>
                                    @foreach (var cust in ViewBag.CustomerList as SelectList)
                                    {
                                        <option value="@cust.Value">@cust.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 d-flex align-items-center justify-content-center">
                        @*<button class="btn btn-download" id="btnDownload">
                                <i class="fas fa-file-excel me-1"></i> All Customer Report
                            </button>*@
                    </div>
                </div>
            </div>
        </div>

        <!-- REPORT TABLE CARD -->
        <div class="card mb-5">
            <div class="card-header">
                <i class="fas fa-list me-2"></i>Report List
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="tblReports" class="table table-striped table-bordered align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th><i class="fas fa-hashtag"></i> Sr No</th>
                                <th><i class="fas fa-user"></i> Customer Name</th>
                                <th><i class="fas fa-user"></i> Loan No</th>
                                <th><i class="fas fa-calendar-day"></i> Loan Amount</th>
                                @*<th><i class="fas fa-rupee-sign"></i> Pending Amount</th>
                                    <th><i class="fas fa-check-circle"></i> Status</th>*@
                                <th><i class="fas fa-file-excel me-1"></i> Download Excel</th>
                            </tr>
                        </thead>
                        <tbody id="tblReportBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="container text-center py-3 border-top">
        © 2025 Admin Panel | Designed for Funds
    </footer>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/Scripts/Funds_Scripts/ExcelReport.js"></script>
</body>
</html>
