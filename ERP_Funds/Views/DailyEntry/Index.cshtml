@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - Daily Entry</title>
    <link href="~/Content/Admin/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/Content/Admin/css/admin.css" rel="stylesheet" />
    <!-- Toastr -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <!-- Select2 -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/Content/Admin/img/computer.png" />
</head>

<body>
    <input type="hidden" id="hdndailycollectionsid" />
    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#"><i class="fas fa-cogs me-2"></i>AdminPanel</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link" href="~/Customer/Index"><i class="fas fa-users me-1"></i>Customer</a></li>
                    <li class="nav-item"><a class="nav-link" href="~/Loan/Index"><i class="fas fa-hand-holding-usd me-1"></i>Loan</a></li>
                    <li class="nav-item"><a class="nav-link active" href="~/DailyEntry/Index"><i class="fas fa-calendar-day me-1"></i>Daily Entry</a></li>
                    <li class="nav-item"><a class="nav-link" href="~/ExcelReport/Index"><i class="fas fa-chart-bar me-1"></i>Reports</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link logout-btn" href="~/Login/Index"><i class="fas fa-sign-out-alt me-1"></i>Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- PAGE HEADER -->
    <div class="container">
        <div class="page-header mt-4">
            <h2><i class="fas fa-calendar-day me-2"></i>Daily Entry</h2>
            <p class="text-muted">Search customer, add or update their daily entries.</p>
        </div>

        <!-- SELECT CUSTOMER -->
        <div class="card mt-4">
            <div class="card-header"><i class="fas fa-user me-2"></i>Select Customer</div>
            <div class="card-body">
                <div class="row g-3">

                    <!-- Customer Name -->
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="customerName" class="form-label fw-semibold text-dark">
                                <i class="fas fa-user-circle text-primary me-1"></i> Customer Name
                            </label>
                            <div class="input-group">
                                <select id="customerName" name="customerName" class="form-select shadow-sm border px-3" required>
                                    <option value="">-- Select Customer --</option>
                                    @if (ViewBag.CustomerList != null)
                                    {
                                        foreach (var cust in ViewBag.CustomerList as SelectList)
                                        {
                                            <option value="@cust.Value">@cust.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Loan Number -->
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label for="loanno" class="form-label fw-semibold text-dark">
                                <i class="fas fa-file-invoice-dollar text-success me-1"></i> Loan No
                            </label>
                            <div class="input-group">
                                <select id="loanno" name="loanno" class="form-select shadow-sm border px-3" required>
                                    <option value="">-- Select Loan No --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ADD ENTRY -->
        <div class="card mt-4">
            <div class="card-header">
                <i class="fas fa-file-invoice-dollar me-2 text-primary"></i> LOAN SUMMARY
            </div>

            <div class="card-body">
                <form id="formDailysummary">

                    <!-- Row 1: Loan Amount / Loan Duration / Per Day Installment -->
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">
                                <i class="fas fa-indian-rupee-sign text-success me-1"></i> Loan Amount
                            </label>
                            <input type="text" id="loanamount" class="form-control" placeholder="Loan Amount" disabled>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">
                                <i class="fas fa-clock text-primary me-1"></i> Loan Duration (Days)
                            </label>
                            <input type="number" id="loanduration" class="form-control" placeholder="Loan Duration" disabled>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">
                                <i class="fas fa-coins text-warning me-1"></i> Per Day Installment
                            </label>
                            <input type="text" id="perdayinstallment" class="form-control" placeholder="Per Day Installment" disabled>
                        </div>
                    </div>

                    <!-- Row 2: Total Paid / Pending Amount -->
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                <i class="fas fa-money-bill-wave text-success me-1"></i> Total Paid
                            </label>
                            <input type="text" id="totalpaid" class="form-control" placeholder="Total Paid" disabled>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                <i class="fas fa-hourglass-half text-danger me-1"></i> Pending Amount
                            </label>
                            <input type="text" id="pendingamount" class="form-control" placeholder="Pending Amount" disabled>
                        </div>
                    </div>

                    <!-- Row 3: Days Paid / Remaining Days -->
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                <i class="fas fa-calendar-check text-info me-1"></i> Days Paid
                            </label>
                            <input type="text" id="dayspaid" class="form-control" placeholder="Days Paid" disabled>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">
                                <i class="fas fa-calendar-times text-warning me-1"></i> Remaining Days
                            </label>
                            <input type="text" id="remainingdays" class="form-control" placeholder="Remaining Days" disabled>
                        </div>
                    </div>



                </form>
            </div>

        </div>



        <div class="card-header">
            <i class="fas fa-file-invoice-dollar me-2 text-primary"></i>
            TODAY'S ENTRY FORM
        </div>

        <div class="card-body">
            <form id="formDailyEntry">

                <!-- Row 1 -->
                <div class="row g-3 mt-1">

                    <!-- Installment Date -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">
                            <i class="fas fa-calendar-day text-primary me-1"></i>
                            Installment Date
                        </label>
                        <input type="date" id="todaydate" class="form-control" placeholder="Select Date">
                    </div>

                    <!-- Amount Paid Today -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold">
                            <i class="fas fa-hand-holding-usd text-success me-1"></i>
                            Amount Paid Today
                        </label>
                        <input type="text" id="paidtoday" class="form-control" placeholder="Enter Amount">
                    </div>

                </div>

            </form>
        </div>




        <!-- Save Button -->
        <div class="col-12 text-center mt-4">
            <button type="submit" class="btn btn-register px-4" id="btnSubmit">
                <i class="fas fa-save me-2"></i> Save Entry
            </button>
        </div>



        <!-- ENTRIES LIST -->
        <div class="card mt-5 mb-5">
            <div class="card-header"><i class="fas fa-list me-2"></i>Daily Entry List</div>
            <div class="card-body">
                <div class="table-responsive">

                    <div class="table-responsive" style="overflow-x:auto; white-space:nowrap;">
                        <table class="table table-striped table-bordered align-middle" id="tblEntries">
                            <thead class="table-dark">
                                <tr>
                                    <th><i class="fas fa-hashtag"></i> Sr No</th>
                                    <th><i class="fas fa-user"></i> Customer Name</th>
                                    <th><i class="fas fa-file-invoice-dollar"></i> Loan No</th>
                                    <th><i class="fas fa-clock"></i> Loan Duration (Days)</th>
                                    <th><i class="fas fa-coins"></i> Per Day Installments</th>
                                    <th><i class="fas fa-check-circle"></i> Total Paid</th>
                                    <th><i class="fas fa-hourglass-half"></i> Pending Amount</th>
                                    <th><i class="fas fa-calendar-check"></i> Total Days Paid</th>
                                    <th><i class="fas fa-calendar-minus"></i> Remaining Days</th>
                                    <th><i class="fas fa-calendar-day"></i> Installment Date</th>
                                    <th><i class="fas fa-money-bill-wave"></i> Amount Paid Today</th>
                                    <th class="text-center"><i class="fas fa-cogs"></i> Actions</th>
                                </tr>
                            </thead>

                            <!-- BODY WILL BE FILLED BY JS -->
                            <tbody id="tblEntriesBody"></tbody>

                            <!-- TOTAL ROW -->
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="10" class="text-end">Total Amount Paid:</th>
                                    <th id="amountPaidTodayTotal" class="fw-bold"></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>



                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="container text-center py-3 border-top">
        © 2025 Admin Panel | Designed for Funds
    </footer>

    <!-- Scripts -->
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/Funds_Scripts/DailyEntry.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let today = new Date().toISOString().split("T")[0];
            document.getElementById("todaydate").value = today;
        });
    </script>

    <script>
        setInterval(() => {
            let loanAmount = parseFloat(document.getElementById("loanamount").value) || 0;
            let totalPaid = parseFloat(document.getElementById("totalpaid").value) || 0;

            document.getElementById("pendingamount").value = (loanAmount - totalPaid).toFixed(2);
        }, 500); // runs every 0.5 second
    </script>

    <script>
       
    </script>



</body>
</html>
