
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - Customer Registration</title>
    <link href="~/Content/Admin/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/Content/Admin/css/admin.css" rel="stylesheet" />
    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/Content/Admin/img/computer.png" />

    <style>
        .toast{
            opacity: 0.9 !important;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="fas fa-cogs me-2"></i>AdminPanel
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- Menu -->
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="~/Customer/Index">
                            <i class="fas fa-users me-1"></i>Customer
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/Loan/Index">
                            <i class="fas fa-hand-holding-usd me-1"></i>Loan
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/DailyEntry/Index">
                            <i class="fas fa-calendar-day me-1"></i>Daily Entry
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="~/ExcelReport/Index">
                            <i class="fas fa-chart-bar me-1"></i>Reports
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link logout-btn" href="~/Login/Index">
                            <i class="fas fa-sign-out-alt me-1"></i>Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hidden field ID fixed -->
    <input type="hidden" id="hdncustomerid" value="" />

    <!-- PAGE HEADER -->
    <div class="container">
        <div class="page-header mt-4">
            <h2><i class="fas fa-user-plus me-2"></i>New Customer Registration</h2>
            <p class="text-muted">Add new customer to the system using this form.</p>
        </div>

        <!-- REGISTRATION FORM -->
        <div class="card mt-4">
            <div class="card-header">
                <i class="fas fa-user-edit me-2"></i>Customer Form
            </div>
            <div class="card-body">
                <form>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label for="firstName" class="form-label">
                                <i class="fas fa-user"></i> Customer Name
                            </label>
                            <input type="text" class="form-control" id="Name" placeholder="Enter Customer Name" required>
                        </div>

                        <div class="col-md-6">
                            <label for="phone" class="form-label">
                                <i class="fas fa-phone"></i> Phone
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-mobile-alt"></i></span>
                                <input type="tel" class="form-control" id="phone" placeholder="Enter phone number">
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="address" class="form-label">
                                <i class="fas fa-home"></i> Address
                            </label>
                            <textarea class="form-control" id="address" rows="2" placeholder="Enter address"></textarea>
                        </div>

                        <div class="col-md-12 text-center mt-3">
                            <button type="button" class="btn btn-register me-2" id="btnSubmit">
                                <i class="fas fa-user-plus me-2"></i>Register Customer
                            </button>
                            <button type="button" class="btn btn-secondary" id="btnCancel" style="display:none;">
                                <i class="fas fa-times me-2"></i>Cancel
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- CUSTOMER LIST TABLE -->
        <div class="card mt-5 mb-5">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-list me-2"></i> Customer List</span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle" id="tblcustomer">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col"><i class="fas fa-list-ol"></i> Sr No</th>
                                <th scope="col"><i class="fas fa-user-circle"></i> Name</th>
                                <th scope="col"><i class="fas fa-phone-alt"></i> Phone</th>
                                <th scope="col"><i class="fas fa-map-marker-alt"></i> Address</th>
                                <th scope="col" class="text-center"><i class="fas fa-tools"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody id="tblcustomertbody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


    </div>

    <!-- FOOTER -->
    <footer class="container text-center py-3 border-top">
        © 2025 Admin Panel | Designed for Funds
    </footer>

    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <!-- Toastr JS (after jQuery) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/Funds_Scripts/Customer.js"></script>
</body>
</html>